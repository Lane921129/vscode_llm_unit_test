  "testFile": "import unittest\nfrom unittest import mock\nimport bmi as target_module\n\n\nclass TestCaseTable(unittest.TestCase):\n    def test_c1(self):\n        \"\"\"C1 normal: 一般體重\"\"\"\n        result = target_module.calculate_bmi(*(65, 170), **{})\n        self.assertEqual(result, (22.49, '健康體位'))\n\n    def test_c2(self):\n        \"\"\"C2 boundary: 健康下界\"\"\"\n        result = target_module.calculate_bmi(*(53.465, 170), **{})\n        self.assertEqual(result, (18.5, '健康體位'))\n\n    def test_c3(self):\n        \"\"\"C3 error: 身高為 0\"\"\"\n        with self.assertRaises(ZeroDivisionError):\n            target_module.calculate_bmi(*(60, 0), **{})\n\n    def test_c4(self):\n        \"\"\"C4 normal: 肥胖\"\"\"\n        result = target_module.calculate_bmi(*(90, 170), **{})\n        self.assertEqual(result, (31.14, '肥胖'))\n\n\nif __name__ == '__main__':\n    unittest.main()\n",
