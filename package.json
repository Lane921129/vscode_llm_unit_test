{
  "name": "llm-unit-test",
  "displayName": "llm_unit_test",
  "publisher": "lane",
  "description": "Using llm to generate unit test and analyzation for user",
  "version": "0.0.1",
  "homepage": "https://github.com/Lane921129/vscode_llm_unit_test#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lane921129/vscode_llm_unit_test.git"
  },
  "bugs": {
    "url": "https://github.com/Lane921129/vscode_llm_unit_test/issues"
  },
  "engines": {
    "vscode": "^1.116.0"
  },
  "license": "MIT",
  "categories": [
    "Testing"
  ],
  "activationEvents": [
    "onView:mutation-test-view"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mutation-test-explorer",
          "title": "突變測試分析",
          "icon": "$(beaker)"
        }
      ]
    },
    "views": {
      "mutation-test-explorer": [
        {
          "type": "webview",
          "id": "mutation-test-view",
          "name": "模型與測試設定"
        }
      ]
    },
    "commands": [
      {
        "command": "llm-unit-test.runCaptureAndTest",
        "title": "執行自動化測試循環"
      },
      {
        "command": "llm-unit-test.runBatchAnalysis",
        "title": "設定批次突變測試"
      },
      {
        "command": "llm-unit-test.abortTest",
        "title": "中止突變測試"
      },
      {
        "command": "llm-unit-test.preparePythonEnvironment",
        "title": "檢查並補齊 Python 測試環境"
      }
    ],
    "configuration": {
      "title": "LLM 自動化測試設定",
      "properties": {
        "llmUnitTest.projectPath": {
          "type": "string",
          "default": "",
          "description": "測試專案資料夾路徑"
        },
        "llmUnitTest.outputPath": {
          "type": "string",
          "default": "",
          "description": "測試結果輸出資料夾路徑"
        },
        "llmUnitTest.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "zh-tw"
          ],
          "default": "auto",
          "description": "UI and output language (auto will follow VS Code language)"
        },
        "llmUnitTest.promptStrategy": {
          "type": "string",
          "enum": [
            "auto",
            "small",
            "large"
          ],
          "default": "auto",
          "description": "Prompt strategy: small (strict formatting) vs large (advanced reasoning)"
        },
        "llmUnitTest.ollamaBaseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "Base URL for Ollama API"
        },
        "llmUnitTest.cloudThinkingMode": {
          "type": "string",
          "enum": ["minimal", "provider-default"],
          "default": "minimal",
          "description": "Cloud 思考量：minimal 優先降低等待時間；供應商明確不支援時沿原時限回退。provider-default 使用服務預設。兩者均保留完整測試品質檢查。"
        },
        "llmUnitTest.pythonPath": {
          "type": "string",
          "default": "",
          "description": "測試使用的 Python。可用「檢查並補齊 Python 測試環境」尋找相依完整的既有環境並保存完整路徑；AST、模型資格、Trace、coverage 與突變測試共用此設定。留空時沿用專案／工作區 .venv，否則使用 PATH python。"
        },
        "llmUnitTest.packageMappings": {
          "type": "object",
          "default": {},
          "additionalProperties": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
          "description": "沒有 requirements 時，優先使用這裡的 import → pip 套件名稱，例如 PIL → Pillow。未設定者在安裝清單帶入同名候選，確認後才嘗試 pip 安裝並重新檢查；也可在清單修改名稱並保存對應。"
        },
        "llmUnitTest.targetBudget": {
          "type": "object",
          "default": {},
          "additionalProperties": false,
          "properties": {
            "timeoutMs": { "type": "integer", "minimum": 1, "default": 600000 },
            "logicalRequests": { "type": "integer", "minimum": 0, "default": 20 },
            "transportAttempts": { "type": "integer", "minimum": 0, "default": 40 },
            "estimatedInputTokens": { "type": "integer", "minimum": 0, "default": 200000 },
            "candidateAttempts": { "type": "integer", "minimum": 0, "default": 20 }
          },
          "description": "每個目標共用的總預算；角色、策略切換與重試不會重設。輸入 tokens 是每次傳送的估算，不是供應商實際計費；耗盡時保留已驗證成果並標示未完成。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
      "test:python": "node test/run_python_tests.js",
    "test:unit": "npm run compile-tests && node test/run_unit_tests.js && npm run test:webview && npm run test:python",
    "test:webview": "node test/extract_script.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.17",
    "@types/vscode": "^1.116.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
